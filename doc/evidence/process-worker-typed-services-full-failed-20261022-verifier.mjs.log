async function walk(root,prefix=''){const names=[];for(const e of await fs.readdir(path.join(root,prefix),{withFileTypes:true})){if(['__pycache__','site-packages'].includes(e.name))continue;assert.ok(!e.isSymbolicLink());const n=prefix?prefix+'/'+e.name:e.name;if(e.isDirectory())names.push(...await walk(root,n));else if(e.isFile())names.push(n);}return names.sort();}
async function hashes(root,names){const result={};for(let i=0;i<names.length;i+=32)await Promise.all(names.slice(i,i+32).map(async n=>result[n]=sha(await fs.readFile(path.join(root,n)))));return result;}
