+#include "agentflow/agent_worker_planning_rpc.hpp"
+#include "agentflow/http_stream_transport.hpp"
+#include "agentflow/mcp_wire.hpp"
+#include "nlohmann/json.hpp"
+#include <mutex>
+#include <set>
+namespace agentflow {
+namespace {
+using Json=nlohmann::json;
+std::string identifier(const Json& value){if(!value.is_string())throw Conflict("Planning identifier must be text");auto text=value.get<std::string>();if(text.empty()||text.size()>256||text.find('\0')!=std::string::npos)throw Conflict("Invalid planning identifier");return text;}
+RunState state(const std::string& value){for(const auto candidate:{RunState::running,RunState::paused,RunState::completed,RunState::failed,RunState::cancelled})if(value==to_string(candidate))return candidate;throw Conflict("Invalid planning result state");}
+void validate(const DynamicExecutionResult& result,const AgentWorkerScope& scope){
+    const auto& run=result.root;if(run.id!=scope.run_id||run.graph_root||run.session_id.empty()||run.session_id.size()>256||run.parent_id.size()>256||run.node_id.size()>256||run.provider_context_json.size()>65536||(scope.root_id==scope.run_id)!=run.parent_id.empty()||result.paused!=(run.state==RunState::paused)||result.call_id.size()>256||result.result_json.size()>4*1024*1024)throw Conflict("Planning result differs from captured owner");(void)state(to_string(run.state));(void)identifier(run.session_id);if(!result.call_id.empty())(void)identifier(result.call_id);if(!result.result_json.empty())(void)mcp_compact_object(result.result_json);if(!run.provider_context_json.empty())(void)mcp_compact_object(run.provider_context_json);
+}
+std::string encode(const DynamicExecutionResult& result,const AgentWorkerScope& scope){validate(result,scope);const auto& run=result.root;return Json{{"run",{{"id",run.id},{"session_id",run.session_id},{"state",to_string(run.state)},{"parent_id",run.parent_id},{"node_id",run.node_id},{"graph_root",run.graph_root},{"provider_context_json",run.provider_context_json}}},{"call_id",result.call_id},{"result_json",result.result_json},{"paused",result.paused}}.dump();}
+DynamicExecutionResult decode(const std::string& bytes,const AgentWorkerScope& scope){const auto value=Json::parse(mcp_compact_object(bytes));if(value.size()!=4||!value.at("run").is_object()||value.at("run").size()!=7||!value.at("paused").is_boolean()||!value.at("call_id").is_string()||!value.at("result_json").is_string())throw Conflict("Invalid planning result envelope");const auto& run=value.at("run");if(!run.at("graph_root").is_boolean())throw Conflict("Invalid planning run projection");DynamicExecutionResult result{{run.at("id").get<std::string>(),run.at("session_id").get<std::string>(),state(run.at("state").get<std::string>()),run.at("parent_id").get<std::string>(),run.at("node_id").get<std::string>(),run.at("graph_root").get<bool>(),run.at("provider_context_json").get<std::string>()},value.at("call_id").get<std::string>(),value.at("result_json").get<std::string>(),value.at("paused").get<bool>()};validate(result,scope);return result;}
+struct Bound {AgentWorkerPlanningBinding binding;std::mutex mutex;std::set<std::string> entered;};
+}
+AgentWorkerRpcHandler bind_agent_worker_planning_rpc(AgentWorkerPlanningBinding binding,const AgentWorkerScope& scope){
+    if(binding.scope!=scope||!binding.invoke||!binding.resume||!binding.healthy)throw std::invalid_argument("Planning endpoint requires its captured native binding");auto owner=std::make_shared<Bound>();owner->binding=std::move(binding);
+    return [owner](const std::string& method,const std::string& payload,AgentWorkerRpcSink,std::stop_token cancel)->std::string{
+        if(method!="planning.invoke"&&method!="planning.resume"&&method!="planning.healthy")throw AgentWorkerRpcRemoteError("unsupported");std::string attempt,call;
+        try{if(method=="planning.healthy"){if(payload!="{}")throw Conflict("Invalid planning health request");}else{const auto value=Json::parse(mcp_compact_object(payload));if(value.size()!=(method=="planning.invoke"?3:2)||!value.at("version").is_number_integer()||value.at("version")!=1)throw Conflict("Invalid planning request");call=identifier(value.at("call_id"));if(method=="planning.invoke")attempt=identifier(value.at("attempt_id"));}}
+        catch(const Conflict&){throw AgentWorkerRpcRemoteError("rejected");}catch(const std::exception&){throw AgentWorkerRpcRemoteError("rejected");}
+        std::unique_lock lock(owner->mutex,std::try_to_lock);if(!lock.owns_lock())throw AgentWorkerRpcRemoteError("rejected");if(cancel.stop_requested())throw AgentWorkerRpcRemoteError("cancelled");if(method=="planning.healthy")return Json{{"healthy",owner->binding.healthy()}}.dump();
+        if(owner->entered.size()>=64||!owner->entered.insert(Json::array({method,attempt,call}).dump()).second)throw AgentWorkerRpcRemoteError("rejected");
+        try{const auto result=method=="planning.invoke"?owner->binding.invoke(attempt,call,cancel):owner->binding.resume(call,cancel);try{return encode(result,owner->binding.scope);}catch(...){throw DynamicOutcomeUnrecorded("Native planning result cannot be projected; no replay is authorized");}}
+        catch(const DynamicPlanRejected& error){throw AgentWorkerRpcRemoteError("rejected",error.code);}catch(const DynamicPlanUnavailable&){throw AgentWorkerRpcRemoteError("unsupported");}catch(const DynamicOutcomeUnrecorded&){throw AgentWorkerRpcRemoteError("outcome_unrecorded");}
+    };
+}
+DynamicExecutionResult AgentWorkerPlanningClient::request(const std::string& method,const std::string& payload,std::stop_token cancel){
+    try{auto actual=decode(peer_.call(method,payload,{},cancel),peer_.scope());const auto expected=Json::parse(payload).at("call_id").get<std::string>();if(!actual.call_id.empty()&&actual.call_id!=expected)throw Conflict("Planning acknowledgement belongs to another model call");return actual;}
+    catch(const AgentWorkerRpcRemoteError& error){if(error.code()=="rejected"){if(!error.detail().empty()){if(error.detail()!="invalid_plan_arguments"&&error.detail()!="plan_changed"&&error.detail()!="planning_budget_exhausted"&&error.detail()!="planning_depth_exhausted")throw DynamicOutcomeUnrecorded("Planning rejection was not a bounded native fact");throw DynamicPlanRejected(error.detail());}throw Conflict("Planning RPC rejected captured invocation");}if(error.code()=="unsupported")throw DynamicPlanUnavailable("Planning RPC owner unavailable");if(error.code()=="cancelled")throw TransportCancelled("Planning RPC cancelled before dispatch");throw DynamicOutcomeUnrecorded("Planning RPC outcome requires ownership recovery; no replay is authorized");}
+    catch(const AgentWorkerRpcClosed&){throw DynamicOutcomeUnrecorded("Planning RPC lost acknowledgement; no replay is authorized");}catch(const AgentWorkerRpcTimeout&){throw DynamicOutcomeUnrecorded("Planning RPC observation expired; retain native ownership");}catch(const AgentWorkerRpcCancelled&){throw DynamicOutcomeUnrecorded("Planning RPC observation cancelled; retain native ownership");}
+    catch(const Conflict&){throw DynamicOutcomeUnrecorded("Planning RPC returned invalid owner facts");}catch(const Json::exception&){throw DynamicOutcomeUnrecorded("Planning RPC returned malformed facts");}catch(const McpProtocolError&){throw DynamicOutcomeUnrecorded("Planning RPC returned malformed facts");}
+}
+DynamicExecutionResult AgentWorkerPlanningClient::invoke(const std::string& parent,const ModelToolCall& call,[[maybe_unused]] const std::string& assistant,const std::string& attempt,[[maybe_unused]] const AgentSettings& settings,[[maybe_unused]] const DynamicPlanCapabilities& capabilities,[[maybe_unused]] std::shared_ptr<RootExecutionBudget> budget,std::stop_token cancel,[[maybe_unused]] DynamicInstructionPrecondition guidance){if(parent!=peer_.scope().run_id)throw Conflict("Planning caller differs from bound worker");(void)identifier(call.id);(void)identifier(attempt);return request("planning.invoke",Json{{"version",1},{"attempt_id",attempt},{"call_id",call.id}}.dump(),cancel);}
+DynamicExecutionResult AgentWorkerPlanningClient::resume(const std::string& parent,const std::string& call,[[maybe_unused]] const AgentSettings& settings,[[maybe_unused]] const DynamicPlanCapabilities& capabilities,[[maybe_unused]] std::shared_ptr<RootExecutionBudget> budget,std::stop_token cancel,[[maybe_unused]] DynamicInstructionPrecondition guidance){if(parent!=peer_.scope().run_id)throw Conflict("Planning resume differs from bound worker");(void)identifier(call);return request("planning.resume",Json{{"version",1},{"call_id",call}}.dump(),cancel);}
+bool AgentWorkerPlanningClient::healthy()const{try{const auto value=Json::parse(mcp_compact_object(peer_.call("planning.healthy","{}")));if(value.size()!=1||!value.at("healthy").is_boolean())throw Conflict("Invalid planning health result");return value.at("healthy").get<bool>();}catch(...){throw DynamicOutcomeUnrecorded("Planning owner health could not be observed");}}
+}
