+int main(int argc,char** argv){try{if(argc>1&&std::string(argv[1])=="agent-channel-worker")return child(argc,argv);check(argc==1,"Unexpected planning fixture arguments");std::atomic<unsigned> invokes{0},resumes{0};std::atomic<bool> done{false};AgentWorkerPlanningBinding binding;binding.scope=scope();binding.healthy=[] {return true;};binding.invoke=[&](const std::string& attempt,const std::string& call,std::stop_token){++invokes;check(!attempt.empty()&&!call.empty(),"Planning binding must receive captured identity only");if(attempt=="rejected-attempt")throw DynamicPlanRejected("plan_changed");if(attempt=="uncertain-attempt")throw DynamicOutcomeUnrecorded("Synthetic lost durable result");auto actual=result();if(attempt=="bad-result-attempt")actual.root.id="foreign-root";if(attempt=="foreign-receipt-attempt")actual.call_id="foreign-call";return actual;};binding.resume=[&](const std::string& call,std::stop_token){++resumes;check(call=="accepted-native-call","Resume must retain actual accepted call");return result(true);};auto wrong=scope();wrong.generation="foreign-generation";rejects<std::invalid_argument>([&]{bind_agent_worker_planning_rpc(binding,wrong);});auto handler=bind_agent_worker_planning_rpc(binding,scope());auto worker=AgentWorkerProcess::launch(ForegroundProcess::bind_executable(executable()),scope(),Clock::now()+10s);check(worker->pid()!=GetCurrentProcessId()&&worker->creation_time()!=0,"Planning boundary needs actual distinct SDK IPC child");AgentWorkerRpcPeer peer(worker->channel(),[&](const std::string& method,const std::string& payload,AgentWorkerRpcSink sink,std::stop_token stop){check(payload.find("NEVER_SERIALIZE")==std::string::npos,"Native capabilities must not cross planning IPC");if(method=="fixture.done"){check(payload=="{}","Unexpected fixture completion");done=true;return std::string{"{}"};}return handler(method,payload,std::move(sink),stop);},Clock::now()+30s);peer.start();peer.wait_closed();peer.stop();check(worker->wait(Clock::now()+5s)==0&&!worker->alive()&&done,"Planning child must exit cleanly after exact remote calls");check(invokes==5&&resumes==1,"Planning replay/forgery must never re-enter backend binding");std::cout<<"Planning execution SDK IPC boundary passed actual child invoke/resume/health, exact UTF-8 native receipt and paused outcome, scoped binding, duplicate rejection, bounded plan errors, unrecorded/malformed outcome fail-stop, and private native capabilities absent from wire. Controlled backend binding only; durable planning admission and product worker assembly remain unverified."<<std::endl;return 0;}catch(const std::exception& error){std::cerr<<error.what()<<std::endl;return 1;}}
