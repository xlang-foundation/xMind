+using namespace agentflow;using Json=nlohmann::json;using Clock=std::chrono::steady_clock;using namespace std::chrono_literals;
+namespace {
+void check(bool value,const char* message){if(!value)throw std::runtime_error(message);}
+template<class Error,class F>void rejects(F action){try{action();}catch(const Error&){return;}throw std::runtime_error("Expected planning boundary rejection");}
+AgentWorkerScope scope(){return {"planning-root","planning-root","planning-workspace","planning-generation",3};}
+DynamicExecutionResult result(bool paused=false){return {{"planning-root","planning-session",paused?RunState::paused:RunState::running,"","",false,R"({"model_id":"controlled"})"},"accepted-native-call",R"({"observed":"雪","native_receipt":true})",paused};}
+std::string executable(){std::wstring value(32768,L'\0');const auto n=GetModuleFileNameW(nullptr,value.data(),static_cast<DWORD>(value.size()));check(n&&n<value.size(),"Planning fixture image unavailable");value.resize(n);return std::filesystem::path(value).string();}
+int child(int argc,char** argv){check(argc==4&&std::string(argv[2])=="--channel-handle","Planning fixture only accepts inherited bootstrap");std::uintptr_t handle=0;const std::string text=argv[3];const auto parsed=std::from_chars(text.data(),text.data()+text.size(),handle);check(parsed.ec==std::errc{}&&parsed.ptr==text.data()+text.size(),"Invalid inherited handle");auto channel=AgentWorkerChannel::accept_inherited(handle,Clock::now()+10s);check(channel->scope()==scope(),"Planning fixture scope changed");AgentWorkerRpcPeer peer(*channel,[](const std::string&,const std::string&,AgentWorkerRpcSink,std::stop_token)->std::string{throw AgentWorkerRpcRemoteError("unsupported");},Clock::now()+30s);peer.start();AgentWorkerPlanningClient client(peer);AgentSettings settings;settings.instructions="NEVER_SERIALIZE_NATIVE_SETTINGS";DynamicPlanCapabilities capabilities;capabilities.backend_identity="NEVER_SERIALIZE_PRIVATE_CAPABILITIES";const ModelToolCall call{"accepted-native-call","plan_tasks",R"({"native_only":"NEVER_SERIALIZE_TOOL_ARGUMENTS"})"};const auto actual=client.invoke(scope().run_id,call,"NEVER_SERIALIZE_ASSISTANT","native-attempt",settings,capabilities,{});check(actual.root.id==scope().run_id&&!actual.paused&&actual.call_id=="accepted-native-call"&&actual.result_json==result().result_json,"Planning invoke must preserve exact native UTF-8 receipt and owner");rejects<Conflict>([&]{client.invoke(scope().run_id,call,"","native-attempt",settings,capabilities,{});});rejects<Conflict>([&]{client.invoke("foreign-root",call,"","new-attempt",settings,capabilities,{});});check(client.healthy(),"Planning health must come from bound backend");const auto paused=client.resume(scope().run_id,"accepted-native-call",settings,capabilities,{});check(paused.paused&&paused.root.state==RunState::paused&&paused.result_json==actual.result_json,"Planning resume must preserve actual paused outcome");rejects<Conflict>([&]{client.resume(scope().run_id,"accepted-native-call",settings,capabilities,{});});try{client.invoke(scope().run_id,{"rejected-call","plan_tasks","{}"},"","rejected-attempt",settings,capabilities,{});throw std::runtime_error("Rejected plan became successful");}catch(const DynamicPlanRejected& error){check(error.code=="plan_changed","Bounded planning rejection code must survive IPC");}rejects<DynamicOutcomeUnrecorded>([&]{client.invoke(scope().run_id,{"uncertain-call","plan_tasks","{}"},"","uncertain-attempt",settings,capabilities,{});});rejects<DynamicOutcomeUnrecorded>([&]{client.invoke(scope().run_id,{"bad-call","plan_tasks","{}"},"","bad-result-attempt",settings,capabilities,{});});rejects<DynamicOutcomeUnrecorded>([&]{client.invoke(scope().run_id,{"receipt-call","plan_tasks","{}"},"","foreign-receipt-attempt",settings,capabilities,{});});for(const auto* forged:{R"({"version":1,"attempt_id":"forged","call_id":"forged","settings":{}})",R"({"version":1,"version":1,"attempt_id":"forged","call_id":"forged"})",R"({"version":2,"attempt_id":"forged","call_id":"forged"})",R"({"version":1,"attempt_id":4,"call_id":"forged"})"})rejects<AgentWorkerRpcRemoteError>([&]{peer.call("planning.invoke",forged);});peer.call("fixture.done","{}");peer.stop();return 0;}
