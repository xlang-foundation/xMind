import fs from 'node:fs/promises';import path from 'node:path';import assert from 'node:assert/strict';import {createHash} from 'node:crypto';import {execFileSync,spawn} from 'node:child_process';
const repo='D:/CantorAI2026/xMind',out=repo+'/.agentflow/client-delivery-validation/0.1.61';await fs.mkdir(out,{recursive:true});const sha=b=>createHash('sha256').update(b).digest('hex');const git=args=>execFileSync('git',args,{cwd:repo,windowsHide:true,encoding:'utf8',maxBuffer:16*1024*1024}).trim();const names=()=>git(['ls-files','--','Native','extensions/vscode','views/browser','Tools','AGENTS.md','LICENSE']).split(/\r?\n/).sort();async function walk(root,prefix=''){const result=[];for(const e of await fs.readdir(path.join(root,prefix),{withFileTypes:true})){assert(!e.isSymbolicLink());const n=prefix?prefix+'/'+e.name:e.name;if(e.isDirectory())result.push(...await walk(root,n));else if(e.isFile())result.push(n);}return result.sort();}async function hashes(root,names){const result={};for(let i=0;i<names.length;i+=32)await Promise.all(names.slice(i,i+32).map(async n=>result[n]=sha(await fs.readFile(path.join(root,n)))));return result;}const dependencies=repo+'/extensions/vscode/node_modules';const testNames=async(folder,suffix)=>(await fs.readdir(repo+'/'+folder)).filter(n=>n.endsWith(suffix)).sort().map(n=>folder+'/'+n);const suites={extension:await testNames('extensions/vscode/tests','.test.js'),browser:await testNames('views/browser/tests','.test.cjs')};assert(suites.extension.length>0&&suites.browser.length>0);const before={revision:git(['rev-parse','HEAD']),patch:sha(execFileSync('git',['diff','HEAD','--binary'],{cwd:repo,windowsHide:true})),script:sha(await fs.readFile(new URL(import.meta.url))),node:sha(await fs.readFile(process.execPath)),project:await hashes(repo,names()),dependencies:await hashes(dependencies,await walk(dependencies)),suites};await fs.writeFile(out+'/inputs-before-tests.json',JSON.stringify(before,null,2)+'\n',{flag:'wx'});async function run(label,args){return new Promise((resolve,reject)=>{const startedAt=new Date().toISOString(),child=spawn(process.execPath,args,{cwd:repo,windowsHide:true,stdio:['ignore','pipe','pipe']});let bytes='';child.stdout.on('data',b=>bytes+=b);child.stderr.on('data',b=>bytes+=b);child.once('error',reject);child.once('close',async code=>{try{await fs.writeFile(out+'/'+label+'.log',bytes,{flag:'wx'});const summary={pid:child.pid,startedAt,endedAt:new Date().toISOString(),exitCode:code,logSha256:sha(Buffer.from(bytes))};for(const key of ['tests','pass','fail','cancelled','skipped','todo','duration_ms']){const match=bytes.match(new RegExp('^# '+key+' ([0-9.]+)','m'));if(match)summary[key]=Number(match[1]);}console.log(JSON.stringify({label,...summary}));resolve(summary);}catch(e){reject(e);}});});}const results={};for(const [label,files] of Object.entries(suites))results[label]=await run(label,['--test',...files]);results.build=await run('browser-build',['views/browser/build.mjs',out+'/browser-assets',out+'/server.mjs']);assert.deepEqual(await hashes(repo,names()),before.project);assert.deepEqual(await hashes(dependencies,await walk(dependencies)),before.dependencies);assert.equal(sha(await fs.readFile(process.execPath)),before.node);assert.equal(sha(await fs.readFile(new URL(import.meta.url))),before.script);assert.equal(git(['rev-parse','HEAD']),before.revision);assert.equal(sha(execFileSync('git',['diff','HEAD','--binary'],{cwd:repo,windowsHide:true})),before.patch);assert.deepEqual(await testNames('extensions/vscode/tests','.test.js'),suites.extension);assert.deepEqual(await testNames('views/browser/tests','.test.cjs'),suites.browser);const artifacts=await hashes(out+'/browser-assets',await walk(out+'/browser-assets'));await fs.writeFile(out+'/browser-manifest.json',JSON.stringify(artifacts,null,2)+'\n',{flag:'wx'});const receipt={source:before.revision,projectFiles:Object.keys(before.project).length,dependencyFiles:Object.keys(before.dependencies).length,testFiles:Object.fromEntries(Object.entries(suites).map(([k,v])=>[k,v.length])),results,artifacts:Object.keys(artifacts).length,allSourceDependenciesAndSetsUnchanged:true,nativeSuiteRun:false,rendered:false,installed:false,paidInference:false,cpython:false,passed:Object.values(results).every(r=>r.exitCode===0)};await fs.writeFile(out+'/gate.json',JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify(receipt));assert(receipt.passed);
