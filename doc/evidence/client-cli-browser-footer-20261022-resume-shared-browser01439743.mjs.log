const child=spawn(runtime+'/xmind.exe',['serve','--db',source+'/state.sqlite','--modules',runtime+'/modules','--stdlib',runtime+'/stdlib','--port','0','--workspace',originalOwner.workspace,'--workspace-edits','approved','--agent-execution','process-code','--process-config',source+'/processes.yaml','--model','cli-coding-fixture','--model-endpoint','http://127.0.0.1:'+peer.address().port,'--model-tools','supported','--model-stream-usage','supported','--workers','1'],{windowsHide:true,env:{...process.env,XMIND_AUTH_TOKEN:token,XMIND_API_KEY:'restore-local-fixture-key'}});
