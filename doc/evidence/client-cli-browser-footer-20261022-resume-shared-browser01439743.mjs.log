child.stdout.on('data',b=>stdout+=b);child.stderr.on('data',b=>stderr+=b);
async function cli(...args){const result=await execute(runtime+'/xmind.exe',['--port',String(port),...args],{windowsHide:true,env:{...process.env,XMIND_AUTH_TOKEN:token},timeout:15000,maxBuffer:4*1024*1024});return JSON.parse(result.stdout);}
try{
 const deadline=Date.now()+15000;while(Date.now()<deadline&&!port){assert.equal(child.exitCode,null,stderr);const match=/listening on http:\/\/127\.0\.0\.1:(\d+)/.exec(stdout);if(match)port=Number(match[1]);else await delay(20);}assert.ok(port,stderr);
 assert.deepEqual(await cli('history',run.session_id),history);assert.equal((await cli('status',run.id)).state,'completed');
