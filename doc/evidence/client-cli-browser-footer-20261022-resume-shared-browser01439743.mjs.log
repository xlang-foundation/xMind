 assert.ok(proof,'Rendered proof missing; preserve completed task and do not replay');assert.equal(proof.sessionId,run.session_id);assert.equal(proof.runId,run.id);assert.equal(proof.historyMessages,8);assert.equal(proof.reloaded,true);assert.equal(proof.passed,true);
 assert.deepEqual(await cli('history',run.session_id),history);assert.equal((await cli('status',run.id)).state,'completed');assert.equal(calls,0);
 await fs.writeFile(out+'/gate.json',JSON.stringify({passed:true,sessionId:run.session_id,runId:run.id,originalCodingModelCalls:4,restorationModelCalls:calls,historyExact:true,historyMessages:8,actualOperations:operations,renderedProof:proof,initialHarnessFailurePreserved:true,completedTaskReplayed:false,nativeSha256:createHash('sha256').update(await fs.readFile(runtime+'/xmind.exe')).digest('hex'),scope:'Actual packaged CLI coding followed by backend restart and actual rendered browser history restoration; no new coding task submitted. Managed workspace switching and VS Code remain separate.',installed:false,paidInference:false},null,2)+'\n',{flag:'wx'});
 console.log(JSON.stringify({passed:true,sessionId:run.session_id,restorationModelCalls:0}));
}finally{
 if(view)await view.close();if(child.exitCode===null)child.kill();await closed;await new Promise(resolve=>peer.close(resolve));await fs.writeFile(out+'/backend-stdout.log',stdout,{flag:'wx'});await fs.writeFile(out+'/backend-stderr.log',stderr,{flag:'wx'});
