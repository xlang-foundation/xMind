 const browser=(await view.listen(0))+'/ui/';await fs.writeFile(out+'/expected.json',JSON.stringify({browser,sessionId:run.session_id,runId:run.id,history,modelCallsBeforeRestart:4,restoreModelCalls:0},null,2)+'\n',{flag:'wx'});
 console.log(JSON.stringify({ready:true,browser,sessionId:run.session_id,runId:run.id,pid:child.pid}));
