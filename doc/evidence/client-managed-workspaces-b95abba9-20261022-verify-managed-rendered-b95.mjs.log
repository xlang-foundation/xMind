import fs from 'node:fs/promises';
import assert from 'node:assert/strict';
import {spawn,execFile} from 'node:child_process';
import {promisify} from 'node:util';
import {randomBytes,createHash} from 'node:crypto';
import {pathToFileURL} from 'node:url';
import {setTimeout as delay} from 'node:timers/promises';
const repo='D:/CantorAI2026/xMind',base=repo+'/.agentflow/client-delivery-validation/b95abba9',out=base+'/managed-rendered',prior=repo+'/.agentflow/client-delivery-validation/01439743/managed-upgrade',profiles=prior+'/profiles',runtime=out+'/runtime',second='D:/CantorAI2026/TestProj/xmind-delivery-validation/managed-browser-second-b95abba9';
const read=async p=>JSON.parse(await fs.readFile(p,'utf8')),execute=promisify(execFile),sha=b=>createHash('sha256').update(b).digest('hex');
const accepted=await read(prior+'/gate.json'),stage=await read(base+'/package/stage-receipt.json');assert.equal(accepted.passed,true);assert.equal(accepted.ownedOwnerRetirementObserved,true);
await fs.mkdir(out);await fs.mkdir(second);await fs.writeFile(second+'/second-workspace.txt','Only the second managed workspace contains this marker.\n',{flag:'wx'});await fs.cp(base+'/package/native-runtime',runtime,{recursive:true,errorOnExist:true,force:false});
const expectedNative=JSON.parse(await fs.readFile(runtime+'/native-runtime-manifest.json','utf8')).files['xmind.exe'];assert.equal(sha(await fs.readFile(runtime+'/xmind.exe')),expectedNative);
const token=randomBytes(32).toString('hex'),env={...process.env};for(const k of Object.keys(env))if(k==='XMIND_AUTH_TOKEN'||k==='XMIND_API_KEY'||k.startsWith('XMIND_UI_'))delete env[k];
let sequence=0,host,viewError='',passed=false;const owners=new Map(),commands=[];
async function invoke(args,cwd=accepted.owner.workspace){const result=await execute(runtime+'/xmind.exe',args,{cwd,env,windowsHide:true,timeout:60000,maxBuffer:4*1024*1024});const n=++sequence;await fs.writeFile(out+'/'+n+'-stdout.log',result.stdout,{flag:'wx'});await fs.writeFile(out+'/'+n+'-stderr.log',result.stderr,{flag:'wx'});commands.push({args,cwd,stdout:n+'-stdout.log',stderr:n+'-stderr.log'});return JSON.parse(result.stdout);}
async function remember(pid){const identity=await invoke(['admin','inspect-owner-process',String(pid)]);assert.equal(identity.process_id,pid);owners.set(pid,identity);await fs.writeFile(out+'/owners.json',JSON.stringify([...owners.values()],null,2)+'\n');}
async function retire(pid,identity){const current=await invoke(['admin','inspect-owner-process',String(pid)]);assert.equal(current.process_birth,identity.process_birth);const queried=await execute('powershell.exe',['-NoProfile','-Command',`Get-CimInstance Win32_Process -Filter "ProcessId=${pid}" | Select-Object ProcessId,ExecutablePath | ConvertTo-Json -Compress`],{windowsHide:true,timeout:15000});const image=JSON.parse(queried.stdout);assert.equal(image.ProcessId,pid);const real=await fs.realpath(image.ExecutablePath),root=await fs.realpath(profiles);assert.ok(real.toLowerCase().startsWith(root.toLowerCase()+'\\'));assert.equal(sha(await fs.readFile(real)),expectedNative);process.kill(pid);assert.equal((await invoke(['admin','observe-owner-exit',String(pid),identity.process_birth,'10000'])).exited,true);}
const view=spawn(runtime+'/xmind.exe',['view','--workspace',accepted.owner.workspace,'--profile-root',profiles,'--ready-file',out+'/ready-host/ready.json','--config',prior+'/providers.yaml'],{cwd:accepted.owner.workspace,env:{...env,XMIND_VIEW_TOKEN:token},windowsHide:true,stdio:['ignore','ignore','pipe']});
const closed=new Promise((resolve,reject)=>{view.once('error',reject);view.once('exit',resolve);});view.stderr.on('data',b=>viewError+=b);
try{
 const deadline=Date.now()+60000;let ready;while(Date.now()<deadline){assert.equal(view.exitCode,null,viewError);try{ready=await read(out+'/ready-host/ready.json');break;}catch(error){if(!['ENOENT','EBUSY'].includes(error.code)&&!(error instanceof SyntaxError))throw error;}await delay(50);}assert.ok(ready,'Managed view readiness deadline');await remember(ready.backend_process_id);
 const history=await invoke(['--profile-root',profiles,'--workspace',accepted.owner.workspace,'history',accepted.session]);assert.deepEqual(history,accepted.history);
 const {createBrowserServer}=await import(pathToFileURL(base+'/package/extension/browser-runtime/server.mjs').href);host=await createBrowserServer({backend:ready.origin,assetRoot:base+'/package/extension/browser-runtime/assets',localAccessToken:token});const browser=(await host.listen(0))+'/ui/';
 await fs.writeFile(out+'/expected.json',JSON.stringify({browser,originalWorkspace:accepted.owner.workspace,secondWorkspace:second,sessionId:accepted.session,completedRoot:accepted.completedRoot,history,modelCalls:0},null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({ready:true,browser,secondWorkspace:second,sessionId:accepted.session,completedRoot:accepted.completedRoot}));
 const until=Date.now()+300000;let proof;while(Date.now()<until){try{proof=await read(out+'/rendered-proof.json');break;}catch(error){if(error.code!=='ENOENT')throw error;}await delay(100);}assert.ok(proof,'Rendered managed workspace proof missing; do not replay graph roots');assert.equal(proof.passed,true);assert.equal(proof.switchedToSecond,true);assert.equal(proof.returnedToOriginal,true);assert.equal(proof.reloaded,true);assert.equal(proof.sessionId,accepted.session);
 const secondInfo=await invoke(['--profile-root',profiles,'--workspace',second,'profile-info'],second);await remember(secondInfo.process_id);assert.equal(secondInfo.started,false);assert.notEqual(secondInfo.process_id,ready.backend_process_id);
 assert.deepEqual(await invoke(['--profile-root',profiles,'--workspace',accepted.owner.workspace,'history',accepted.session]),history);assert.deepEqual(await invoke(['--profile-root',profiles,'--workspace',second,'sessions'],second),[]);passed=true;
 await host.close();host=undefined;if(view.exitCode===null)view.kill();await closed;for(const [pid,identity]of owners)await retire(pid,identity);
 await fs.writeFile(out+'/gate.json',JSON.stringify({passed:true,proof,originalSession:accepted.session,originalCompletedRoot:accepted.completedRoot,historyExact:true,secondWorkspaceSessions:0,owners:[...owners.values()],ownedFixtureOwnersRetired:true,modelCalls:0,completedGraphsReplayed:false,installed:false},null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({passed:true,modelCalls:0,ownedFixtureOwnersRetired:true}));
}finally{
 await fs.writeFile(out+'/commands.json',JSON.stringify(commands,null,2)+'\n',{flag:'wx'});await fs.writeFile(out+'/view-stderr.log',viewError,{flag:'wx'});if(!passed)console.error(JSON.stringify({retained:true,viewPid:view.pid,owners:[...owners.keys()],out,reason:'Preserve failed UI check and exact fixture owners; never replay completed roots'}));
}
