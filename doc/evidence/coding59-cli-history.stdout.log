      "content": "{\"content\":\"import test from \\\"node:test\\\";\\nimport assert from \\\"node:assert/strict\\\";\\nimport {wrapIndex} from \\\"./wrap-index.mjs\\\";\\ntest(\\\"positive overflow wraps\\\", () => assert.equal(wrapIndex(7, 5), 2));\\ntest(\\\"zero stays at zero\\\", () => assert.equal(wrapIndex(0, 5), 0));\\ntest(\\\"negative one wraps to last\\\", () => assert.equal(wrapIndex(-1, 5), 4));\\ntest(\\\"multiple negative cycles wrap\\\", () => assert.equal(wrapIndex(-9, 4), 3));\\n\",\"folder_id\":\"windows-local-file-v1:fec0809ac0805ab3:e8d12000000005000000000000000000\",\"path\":\"wrap-index.test.mjs\",\"workspace_id\":\"windows-local-file-v1:fec0809ac0805ab3:e8d12000000005000000000000000000\",\"workspace_revision\":1}",
