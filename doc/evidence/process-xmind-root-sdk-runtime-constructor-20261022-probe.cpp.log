#define NOMINMAX
#include <windows.h>
#include "xlang3/cpp/runtime.h"
#include "agent_worker_crash_fixture.hpp"
#include <atomic>
#include <barrier>
#include <iostream>
#include <thread>
#include <vector>
int main(){
    worker_crash_fixture::install();
    for(unsigned i=0;i<20;++i){X::Runtime runtime;}
    std::cout<<"sequential_runtime_constructors=20"<<std::endl;
    std::atomic<unsigned> constructed=0,failed=0;
    std::barrier start(4);
    std::vector<std::thread> threads;
    for(unsigned i=0;i<4;++i)threads.emplace_back([&]{
        for(unsigned round=0;round<20;++round){
            start.arrive_and_wait();
            try{X::Runtime runtime;++constructed;}
            catch(const std::exception& error){++failed;std::cerr<<error.what()<<std::endl;}
            start.arrive_and_wait();
        }
    });
    for(auto& thread:threads)thread.join();
    std::cout<<"concurrent_runtime_constructors="<<constructed<<" failed="<<failed<<std::endl;
    return constructed==80&&failed==0?0:1;
}
