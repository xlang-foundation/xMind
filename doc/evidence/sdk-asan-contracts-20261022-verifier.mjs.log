const dll=await fs.readFile(runtime+'/xlang3_runtime.dll'),pe=dll.readUInt32LE(0x3c),opt=pe+24,sections=[];assert.equal(dll.readUInt16LE(opt),0x20b);for(let i=0;i<dll.readUInt16LE(pe+6);i++){const p=opt+dll.readUInt16LE(pe+20)+40*i;sections.push({rva:dll.readUInt32LE(p+12),size:Math.max(dll.readUInt32LE(p+8),dll.readUInt32LE(p+16)),raw:dll.readUInt32LE(p+20)});}const off=rva=>{const s=sections.find(s=>rva>=s.rva&&rva<s.rva+s.size);assert.ok(s);return s.raw+rva-s.rva;};const imports=[];for(let p=off(dll.readUInt32LE(opt+120));dll.readUInt32LE(p+12);p+=20){const at=off(dll.readUInt32LE(p+12));imports.push(dll.toString('ascii',at,dll.indexOf(0,at)));}assert.ok(imports.some(n=>n.toLowerCase()==='clang_rt.asan_dynamic-x86_64.dll'));
