async function walk(dir,prefix=''){const names=[];for(const e of await fs.readdir(path.join(dir,prefix),{withFileTypes:true})){assert.ok(!e.isSymbolicLink());const n=prefix?prefix+'/'+e.name:e.name;if(e.isDirectory())names.push(...await walk(dir,n));else names.push(n);}return names.sort();}
