assert.equal(git(source,['rev-parse','HEAD']),'f809da864b582a90f77fef408c5c6a0db200e11e');assert.equal(git(source,['status','--porcelain']),'');
try{await fs.mkdir(out);}catch(error){if(error.code!=='EEXIST')throw error;assert.deepEqual(await fs.readdir(out),[],'Existing diagnostic output is not empty');}
async function walk(root,prefix=''){const files=[];for(const e of await fs.readdir(path.join(root,prefix),{withFileTypes:true})){assert.ok(!e.isSymbolicLink());const p=prefix?prefix+'/'+e.name:e.name;if(e.isDirectory())files.push(...await walk(root,p));else if(e.isFile())files.push(p);}return files.sort();}
async function hashes(root,names){const values={};for(let i=0;i<names.length;i+=8)await Promise.all(names.slice(i,i+8).map(async n=>values[n]=sha(await fs.readFile(path.join(root,n)))));return values;}
const sourceNames=()=>git(source,['ls-files','-z']).split('\0').filter(Boolean).sort();
const productRoot=repo+'/build/skill-state-native/Release',productNames=async()=>(await fs.readdir(productRoot)).filter(n=>/\.(exe|dll)$/.test(n)).sort();
const installed='C:/Users/shaw9/.vscode/extensions/agentflow-local.agentflow-0.1.61';
const protectedInstalled=['native-runtime/xmind.exe','native-runtime/native-runtime-manifest.json'];
const before={revision:git(source,['rev-parse','HEAD']),source:await hashes(source,sourceNames()),qualifiedSdk:await hashes(qualified,await walk(qualified)),native:await hashes(productRoot,await productNames()),installed:await hashes(installed,protectedInstalled),scriptSha256:sha(await fs.readFile(new URL(import.meta.url))),nodeSha256:sha(await fs.readFile(process.execPath)),cmakeSha256:sha(await fs.readFile(cmake))};
await fs.writeFile(out+'/inputs-before.json',JSON.stringify(before,null,2)+'\n',{flag:'wx'});
async function verify(){assert.deepEqual(sourceNames(),Object.keys(before.source).sort());assert.deepEqual(await hashes(source,sourceNames()),before.source);assert.equal(git(source,['status','--porcelain']),'');assert.deepEqual(await walk(qualified),Object.keys(before.qualifiedSdk).sort());assert.deepEqual(await hashes(qualified,await walk(qualified)),before.qualifiedSdk);assert.deepEqual(await productNames(),Object.keys(before.native).sort());assert.deepEqual(await hashes(productRoot,await productNames()),before.native);assert.deepEqual(await hashes(installed,protectedInstalled),before.installed);assert.equal(sha(await fs.readFile(new URL(import.meta.url))),before.scriptSha256);assert.equal(sha(await fs.readFile(process.execPath)),before.nodeSha256);assert.equal(sha(await fs.readFile(cmake)),before.cmakeSha256);}
async function run(label,args){return new Promise((resolve,reject)=>{const startedAt=new Date().toISOString(),child=spawn(cmake,args,{cwd:repo,windowsHide:true,stdio:['ignore','pipe','pipe']});let log='';child.stdout.on('data',b=>log+=b);child.stderr.on('data',b=>log+=b);fs.writeFile(out+'/'+label+'-running.json',JSON.stringify({pid:child.pid,startedAt,program:cmake,args},null,2)+'\n',{flag:'wx'}).catch(reject);child.once('error',reject);child.once('close',async(exitCode,signal)=>{try{await fs.writeFile(out+'/'+label+'.log',log,{flag:'wx'});const receipt={pid:child.pid,startedAt,endedAt:new Date().toISOString(),exitCode,signal,logSha256:sha(Buffer.from(log))};await fs.writeFile(out+'/'+label+'-terminal.json',JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});resolve(receipt);}catch(e){reject(e);}});});}
const configured=await run('configure',['-S',source,'-B',build,'-A','x64','-DXLANG3_BUILD_CPYTHON_BRIDGE:BOOL=OFF','-DXLANG3_PYTHON314_EXECUTABLE:FILEPATH=','-DPython3_EXECUTABLE:FILEPATH=','-DCMAKE_DISABLE_FIND_PACKAGE_Python3:BOOL=TRUE','-DXLANG3_RELEASE_PGO_STAGE:STRING=OFF','-DCMAKE_TRY_COMPILE_CONFIGURATION:STRING=Release','-DCMAKE_C_FLAGS:STRING=/DWIN32 /D_WINDOWS /fsanitize=address /Zi','-DCMAKE_CXX_FLAGS:STRING=/DWIN32 /D_WINDOWS /EHsc /fsanitize=address /Zi','-DCMAKE_SHARED_LINKER_FLAGS:STRING=/DEBUG /INCREMENTAL:NO','-DCMAKE_EXE_LINKER_FLAGS:STRING=/DEBUG /INCREMENTAL:NO']);
await verify();if(configured.exitCode!==0){await fs.writeFile(out+'/gate.json',JSON.stringify({diagnosticOnly:true,configured,passed:false,inputsUnchanged:true},null,2)+'\n',{flag:'wx'});throw Error('ASAN configure failed; preserved log');}
const cache=await fs.readFile(build+'/CMakeCache.txt','utf8');assert.match(cache,/XLANG3_BUILD_CPYTHON_BRIDGE:BOOL=OFF/);assert.match(cache,/XLANG3_PYTHON314_EXECUTABLE:FILEPATH=\r?\n/);
const compiled=await run('build',['--build',build,'--config','Release','--target','xlang3_runtime','xlang3','--','/m:1','/nologo']);await verify();
const outputs={};if(compiled.exitCode===0)for(const name of ['xlang3_runtime.dll','xlang3_runtime.lib','xlang3_runtime.pdb','xlang3.exe'])outputs[name]=sha(await fs.readFile(build+'/Release/'+name));
const result={diagnosticOnly:true,sourceRevision:before.revision,sourceFiles:Object.keys(before.source).length,qualifiedSdkFiles:Object.keys(before.qualifiedSdk).length,nativeBinaries:Object.keys(before.native).length,configured,compiled,outputs,allOriginalInputFileSetsAndBytesUnchanged:true,cpythonExecuted:false,runtimeExecuted:false,releaseAcceptance:false,passed:compiled.exitCode===0};await fs.writeFile(out+'/gate.json',JSON.stringify(result,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify(result));assert.equal(result.passed,true);