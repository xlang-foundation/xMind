import fs from 'node:fs/promises';
import path from 'node:path';
import assert from 'node:assert/strict';
import {spawn,execFileSync} from 'node:child_process';
import {createHash} from 'node:crypto';
const repo='D:/CantorAI2026/xMind',source=repo+'/.agentflow/xlang3-ctypes-runtime-fix',qualified=repo+'/.agentflow/xlang3-sdk',out=repo+'/.agentflow/xlang3-asan-diagnostic',build=out+'/build';
const cmake='C:/Program Files/Microsoft Visual Studio/18/Community/Common7/IDE/CommonExtensions/Microsoft/CMake/CMake/bin/cmake.exe';
const git=(root,args)=>execFileSync('git',args,{cwd:root,encoding:'utf8',windowsHide:true,maxBuffer:16*1024*1024}).trim();
const sha=b=>createHash('sha256').update(b).digest('hex');
const processes=execFileSync('powershell.exe',['-NoProfile','-Command',"$p=Get-CimInstance Win32_Process | Where-Object { $_.ProcessId -ne $PID -and ($_.Name -in @('cmake.exe','ctest.exe','MSBuild.exe') -or $_.CommandLine -match 'pyperformance|run_benchmark\\.py|run_pyperformance_xlang3_shimmed\\.py|benchmarks[/\\\\]|scratch[/\\\\]performance[/\\\\]run-') }; @($p | Select-Object ProcessId,Name,CreationDate) | ConvertTo-Json -Compress"],{encoding:'utf8',windowsHide:true}).trim();
