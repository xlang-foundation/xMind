async function walk(root,prefix=''){const result=[];for(const e of await fs.readdir(path.join(root,prefix),{withFileTypes:true})){if(['__pycache__','site-packages'].includes(e.name))continue;assert.ok(!e.isSymbolicLink());const name=prefix?prefix+'/'+e.name:e.name;if(e.isDirectory())result.push(...await walk(root,name));else if(e.isFile())result.push(name);}return result.sort();}
