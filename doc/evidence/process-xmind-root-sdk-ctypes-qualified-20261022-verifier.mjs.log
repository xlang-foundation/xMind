import fs from 'node:fs/promises';
import assert from 'node:assert/strict';
import {createHash} from 'node:crypto';
import {spawn,execFileSync} from 'node:child_process';
const repo='D:/CantorAI2026/xMind',source=repo+'/.agentflow/xlang3-ctypes-runtime-fix',out=repo+'/.agentflow/ctypes-runtime-fix-corrected-build',build=repo+'/.agentflow/ctypes-runtime-fix-build/build';
const cmake='C:/Program Files/Microsoft Visual Studio/18/Community/Common7/IDE/CommonExtensions/Microsoft/CMake/CMake/bin/cmake.exe';
const sha=b=>createHash('sha256').update(b).digest('hex');
const git=args=>execFileSync('git',args,{cwd:source,windowsHide:true,encoding:'utf8',maxBuffer:16*1024*1024}).trim();
await fs.mkdir(out);await fs.mkdir(out+'/evidence');await fs.mkdir(out+'/dumps');
const names=()=>git(['ls-files','--','CMakeLists.txt','AGENTS.md','LICENSE','src','sdk','modules','third_party','tests/cpp']).split(/\r?\n/).sort();
async function hashes(){const result={};const files=names();for(let i=0;i<files.length;i+=24)await Promise.all(files.slice(i,i+24).map(async name=>result[name]=sha(await fs.readFile(source+'/'+name))));return result;}
const before=await hashes(),scriptHash=sha(await fs.readFile(new URL(import.meta.url))),patch=execFileSync('git',['diff','HEAD','--binary'],{cwd:source,windowsHide:true,maxBuffer:16*1024*1024});
await fs.writeFile(out+'/evidence/inputs-before.json',JSON.stringify({parent:git(['rev-parse','HEAD']),source:before,scriptHash,sourcePatchSha256:sha(patch)},null,2)+'\n',{flag:'wx'});await fs.writeFile(out+'/evidence/source.patch',patch,{flag:'wx'});
async function run(name,program,args,env=process.env){return new Promise((resolve,reject)=>{const startedAt=new Date().toISOString(),child=spawn(program,args,{cwd:repo,windowsHide:true,env,stdio:['ignore','pipe','pipe']});let log='';child.stdout.on('data',b=>{log+=b;if(name!=='build')process.stdout.write(b);});child.stderr.on('data',b=>{log+=b;process.stderr.write(b);});child.once('error',reject);child.once('close',async(exitCode,signal)=>{try{await fs.writeFile(out+'/evidence/'+name+'.log',log,{flag:'wx'});const terminal={pid:child.pid,startedAt,completedAt:new Date().toISOString(),exitCode,signal,logSha256:sha(Buffer.from(log))};await fs.writeFile(out+'/evidence/'+name+'-terminal.json',JSON.stringify(terminal,null,2)+'\n',{flag:'wx'});resolve(terminal);}catch(error){reject(error);}});});}
const configured=await run('configure',cmake,['-S',source,'-B',build,'-G','Visual Studio 18 2026','-A','x64','-DXLANG3_BUILD_CPYTHON_BRIDGE=OFF','-DXLANG3_RELEASE_PGO_STAGE=OFF','-DXLANG3_PYTHON314_EXECUTABLE:FILEPATH=']);assert.equal(configured.exitCode,0);
const cache=await fs.readFile(build+'/CMakeCache.txt','utf8');assert.match(cache,/^XLANG3_PYTHON314_EXECUTABLE:FILEPATH=$/m);assert.match(cache,/^XLANG3_BUILD_CPYTHON_BRIDGE:BOOL=OFF$/m);
const built=await run('build',cmake,['--build',build,'--config','Release','--target','xlang3','xlang3_runtime_isolation_tests','--','/m:1','/nologo']);assert.equal(built.exitCode,0);
assert.deepEqual(await hashes(),before);assert.equal(sha(await fs.readFile(new URL(import.meta.url))),scriptHash);
const dll=build+'/Release/xlang3_runtime.dll',candidateSha256=sha(await fs.readFile(dll));
const isolated=await run('isolation',build+'/Release/xlang3_runtime_isolation_tests.exe',[]);
await fs.mkdir(out+'/constructor-control');const oldProbe=repo+'/.agentflow/runtime-constructor-diagnostic/build/Release/sdk_runtime_constructor_probe.exe';await fs.copyFile(oldProbe,out+'/constructor-control/probe.exe',fs.constants.COPYFILE_EXCL);await fs.copyFile(dll,out+'/constructor-control/xlang3_runtime.dll',fs.constants.COPYFILE_EXCL);
const control=await run('constructor-control',out+'/constructor-control/probe.exe',[],{...process.env,XMIND_WORKER_FIXTURE_DUMP_DIR:out+'/dumps'});
assert.deepEqual(await hashes(),before);assert.equal(sha(await fs.readFile(dll)),candidateSha256);
const gate={configured,built,isolated,control,candidateSha256,sourcePatchSha256:sha(patch),trackedInputFiles:Object.keys(before).length,inputsAndSourceFileSetsUnchanged:true,cpython:false,installed:false,originalSdkChanged:false,performanceValidated:false,passed:isolated.exitCode===0&&control.exitCode===0};
await fs.writeFile(out+'/evidence/gate.json',JSON.stringify(gate,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify(gate));assert.equal(gate.passed,true);
