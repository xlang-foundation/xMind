      "arguments": {
        "arguments": [
          "-B",
          "-c",
          "import sys\nfrom fastapi.testclient import TestClient\nfrom app.main import app\n\nclient = TestClient(app, raise_server_exceptions=True)\nfailures = []\n\n# 1. /api/health\nr = client.get('/api/health')\nassert r.status_code == 200, f'health: expected 200 got {r.status_code}'\nbody = r.json()\nassert body['status'] == 'ok', f'health status field: {body}'\nprint(f'[1] GET /api/health -> HTTP {r.status_code}  status={body[\"status\"]!r}  app={body[\"app\"]!r}  version={body[\"version\"]!r}')\n\n# 2. /api/models - full catalog\nr = client.get('/api/models')\nassert r.status_code == 200, f'models: expected 200 got {r.status_code}'\nbody = r.json()\ntotal = body['total']\npage_count = body['pages']\nitem_count = len(body['items'])\nprint(f'[2] GET /api/models -> HTTP {r.status_code}  total={total}  pages={page_count}  items_on_page={item_count}')\nassert total > 0, 'catalog is empty'\nassert item_count > 0, 'no items returned on first page'\n\n# 3. /api/models?search=gpt2\nr = client.get('/api/models', params={'search': 'gpt2'})\nassert r.status_code == 200, f'search gpt2: expected 200 got {r.status_code}'\nbody = r.json()\ngpt2_total = body['total']\ngpt2_ids = [m['id'] for m in body['items']]\nprint(f'[3] GET /api/models?search=gpt2 -> HTTP {r.status_code}  total={gpt2_total}  ids={gpt2_ids}')\nassert gpt2_total > 0, 'search=gpt2 returned no results'\nassert any('gpt2' in mid.lower() or 'gpt2' in m['name'].lower() or 'gpt2' in m.get('summary','').lower()\n           for m, mid in zip(body['items'], gpt2_ids)), 'no gpt2-related model found in results'\n\n# 4. /api/models?sort=not-a-valid-sort -> 422\nr = client.get('/api/models', params={'sort': 'not-a-valid-sort'})\nassert r.status_code == 422, f'invalid sort: expected 422 got {r.status_code}'\nprint(f'[4] GET /api/models?sort=not-a-valid-sort -> HTTP {r.status_code}  (Unprocessable Entity, as expected)')\n\nprint()\nprint('xMind CLI API smoke passed')\n"
        ],
