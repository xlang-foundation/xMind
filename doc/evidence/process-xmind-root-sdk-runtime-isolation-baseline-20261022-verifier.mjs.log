import fs from 'node:fs/promises';
import assert from 'node:assert/strict';
import {createHash} from 'node:crypto';
import {spawn,execFileSync} from 'node:child_process';
const repo='D:/CantorAI2026/xMind',root=repo+'/.agentflow/runtime-constructor-diagnostic/isolation',sdk=repo+'/.agentflow/xlang3-sdk';
const cmake='C:/Program Files/Microsoft Visual Studio/18/Community/Common7/IDE/CommonExtensions/Microsoft/CMake/CMake/bin/cmake.exe';
const sha=b=>createHash('sha256').update(b).digest('hex');
await fs.mkdir(root+'/evidence');await fs.mkdir(root+'/dumps');
const provenance=JSON.parse(await fs.readFile(sdk+'/provenance.json','utf8'));
async function snapshot(){const result={};for(const [file,expected] of Object.entries(provenance.files)){const bytes=await fs.readFile(sdk+'/'+file);assert.equal(sha(bytes),expected);result[sdk+'/'+file]=sha(bytes);}for(const file of [repo+'/.agentflow/xlang3-ctypes-runtime-fix/tests/cpp/runtime_isolation_tests.cpp',repo+'/.agentflow/xlang3-ctypes-runtime-fix/tests/cpp/fixtures/runtime_ctypes_isolation.py',root+'/CMakeLists.txt',root+'/verify.mjs',repo+'/Native/tests/agent_worker_crash_fixture.hpp',sdk+'/provenance.json',sdk+'/Release/xlang3_runtime.dll',sdk+'/Release/xlang3_runtime.lib',process.execPath,cmake])result[file]=sha(await fs.readFile(file));return result;}
const before=await snapshot();await fs.writeFile(root+'/evidence/inputs-before.json',JSON.stringify(before,null,2)+'\n',{flag:'wx'});
const patch=execFileSync('git',['diff','HEAD','--binary','--','Native'],{cwd:repo,windowsHide:true,maxBuffer:16*1024*1024});await fs.writeFile(root+'/evidence/native-pending.patch',patch,{flag:'wx'});
async function run(name,program,args,env=process.env){return new Promise((resolve,reject)=>{const startedAt=new Date().toISOString(),child=spawn(program,args,{cwd:repo,windowsHide:true,env,stdio:['ignore','pipe','pipe']});let log='';child.stdout.on('data',b=>{log+=b;process.stdout.write(b);});child.stderr.on('data',b=>{log+=b;process.stderr.write(b);});child.once('error',reject);child.once('close',async(exitCode,signal)=>{try{await fs.writeFile(root+'/evidence/'+name+'.log',log,{flag:'wx'});const terminal={pid:child.pid,startedAt,completedAt:new Date().toISOString(),exitCode,signal,logSha256:sha(Buffer.from(log))};await fs.writeFile(root+'/evidence/'+name+'-terminal.json',JSON.stringify(terminal,null,2)+'\n',{flag:'wx'});resolve(terminal);}catch(error){reject(error);}});});}
const configured=await run('configure',cmake,['-S',root,'-B',root+'/build','-G','Visual Studio 18 2026','-A','x64']);assert.equal(configured.exitCode,0);
const built=await run('build',cmake,['--build',root+'/build','--config','Release','--','/m:1','/nologo']);assert.equal(built.exitCode,0);
const binary=root+'/build/Release/ctypes_isolation_baseline.exe',binaryHash=sha(await fs.readFile(binary));assert.equal(sha(await fs.readFile(root+'/build/Release/xlang3_runtime.dll')),before[sdk+'/Release/xlang3_runtime.dll']);
const tested=await run('probe',binary,[],{...process.env,XMIND_WORKER_FIXTURE_DUMP_DIR:root+'/dumps'});
assert.deepEqual(await snapshot(),before);assert.equal(sha(execFileSync('git',['diff','HEAD','--binary','--','Native'],{cwd:repo,windowsHide:true,maxBuffer:16*1024*1024})),sha(patch));assert.equal(sha(await fs.readFile(binary)),binaryHash);
const dumps={};for(const name of await fs.readdir(root+'/dumps')){const bytes=await fs.readFile(root+'/dumps/'+name);dumps[name]={sha256:sha(bytes),bytes:bytes.length};}
const gate={configured,built,tested,binarySha256:binaryHash,sdkSha256:before[sdk+'/Release/xlang3_runtime.dll'],allConsumedInputsAndPendingNativePatchUnchanged:true,dumps,sqlite:false,ipc:false,models:false,cpython:false,installed:false,passed:tested.exitCode===0};
await fs.writeFile(root+'/evidence/gate.json',JSON.stringify(gate,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify(gate));
