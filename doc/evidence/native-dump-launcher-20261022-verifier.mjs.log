import fs from 'node:fs/promises';
import path from 'node:path';
import assert from 'node:assert/strict';
import {execFileSync,spawnSync} from 'node:child_process';
import {createHash} from 'node:crypto';
const repo='D:/CantorAI2026/xMind',out=repo+'/.agentflow/native-dump-launcher-verification-start',build=repo+'/.agentflow/native-dump-launcher-build';
const cmake='C:/Program Files/Microsoft Visual Studio/18/Community/Common7/IDE/CommonExtensions/Microsoft/CMake/CMake/bin/cmake.exe';
const preflight=execFileSync('powershell.exe',['-NoProfile','-Command',"$p=Get-CimInstance Win32_Process | Where-Object { $_.ProcessId -ne $PID -and ($_.Name -in @('cmake.exe','ctest.exe','MSBuild.exe') -or $_.CommandLine -match 'pyperformance|run_benchmark\\.py|run_pyperformance_xlang3_shimmed\\.py|benchmarks[/\\\\]|scratch[/\\\\]performance[/\\\\]run-') }; @($p | Select-Object ProcessId,Name,CreationDate) | ConvertTo-Json -Compress"],{encoding:'utf8',windowsHide:true}).trim();
assert.ok(!preflight||preflight==='[]','Native or benchmark work is live: '+preflight);
await fs.mkdir(out);await fs.mkdir(out+'/private-dumps');
const sha=b=>createHash('sha256').update(b).digest('hex');
const names=['.agentflow/native-dump-launcher.cpp','.agentflow/native-dump-probe.cpp','.agentflow/native-dump-launcher-source/CMakeLists.txt'];
async function inputs(){const values={};for(const n of names)values[n]=sha(await fs.readFile(repo+'/'+n));return values;}
const before=await inputs(),product={};for(const n of ['xmind.exe','xlang3_runtime.dll'])product[n]=sha(await fs.readFile(repo+'/build/skill-state-native/Release/'+n));
async function command(label,program,args){const start=new Date().toISOString(),r=spawnSync(program,args,{cwd:repo,windowsHide:true,encoding:'utf8',maxBuffer:16*1024*1024,timeout:120000});await fs.writeFile(out+'/'+label+'.log',(r.stdout??'')+(r.stderr??''),{flag:'wx'});const receipt={program,args,startedAt:start,endedAt:new Date().toISOString(),status:r.status,signal:r.signal,error:r.error?.message};await fs.writeFile(out+'/'+label+'.json',JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});return r;}
const configured=await command('configure',cmake,['-S',repo+'/.agentflow/native-dump-launcher-source','-B',build,'-A','x64']);assert.equal(configured.status,0);
const compiled=await command('build',cmake,['--build',build,'--config','Release','--','/m:1','/nologo']);assert.equal(compiled.status,0);
const launcher=build+'/Release/xmind_native_dump_launcher.exe',probe=build+'/Release/xmind_native_dump_probe.exe';
const normal=await command('normal',launcher,['--dump-dir',out+'/private-dumps','--',probe,'--roundtrip','',"spaces \"quote\" backslash\\ α"]);assert.equal(normal.status,37);assert.equal((await fs.readdir(out+'/private-dumps')).length,0);
const fatal=await command('fatal',launcher,['--dump-dir',out+'/private-dumps','--',probe,'--fault']);assert.equal(fatal.status>>>0,0xc0000005);
const dumps=await fs.readdir(out+'/private-dumps');assert.equal(dumps.length,1);const dump=await fs.readFile(out+'/private-dumps/'+dumps[0]);assert.equal(dump.readUInt32LE(0),0x504d444d);let exception;
for(let i=0;i<dump.readUInt32LE(8);++i){const at=dump.readUInt32LE(12)+i*12;if(dump.readUInt32LE(at)===6)exception=dump.readUInt32LE(dump.readUInt32LE(at+8)+8);}assert.equal(exception,0xc0000005);
assert.deepEqual(await inputs(),before);for(const [n,h]of Object.entries(product))assert.equal(sha(await fs.readFile(repo+'/build/skill-state-native/Release/'+n)),h);
const gate={scope:'Owned diagnostic helper only; no product or release acceptance',passed:true,inputs:before,normalExit:normal.status,fatalExit: fatal.status>>>0,dumpException:exception,privateDumpCount:1,launcherSha256:sha(await fs.readFile(launcher)),probeSha256:sha(await fs.readFile(probe)),nativeRuntimeBytesUnchanged:true,originalTestDeadlinesChanged:false,cpythonExecuted:false};await fs.writeFile(out+'/gate.json',JSON.stringify(gate,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify(gate));
